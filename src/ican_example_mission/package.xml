<?xml version="1.0"?>
<package format="3">
  <name>ican_example_mission</name>
  <version>0.1.0</version>
  <description>Complete iCAN navigation and shooting mission package.</description>
  <maintainer email="user@example.com">iCAN User</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ican_example_navigation</exec_depend>
  <exec_depend>ican_example_ring_aim</exec_depend>
  <exec_depend>ican_referee_system</exec_depend>
  <exec_depend>ican_shoot_sim</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
